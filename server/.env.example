# Server configuration. Copy to .env (at the repo root for deploys, or in the
# directory you run uvicorn from) and fill in. Every key is optional — these
# are the defaults the app uses if unset. All keys use the WEATHER_ prefix.

# --- MQTT broker ---
WEATHER_MQTT_HOST=localhost
WEATHER_MQTT_PORT=1883
WEATHER_MQTT_TOPIC_PREFIX=weather

# Broker auth. Required in production (see deploy/mosquitto.conf). Leave unset
# for an anonymous broker (dev only).
# WEATHER_MQTT_USERNAME=weather
# WEATHER_MQTT_PASSWORD=

# --- Storage ---
# Relative to the working directory, or an absolute path (recommended on the Pi).
WEATHER_DB_PATH=weather.db

# --- HTTP server ---
WEATHER_HTTP_HOST=0.0.0.0
WEATHER_HTTP_PORT=8000

# --- Map ---
# Mapbox public access token (pk....). Without it the dashboard map shows a
# fallback message; the rest of the dashboard still works. Create and restrict
# one at https://account.mapbox.com/access-tokens/
# WEATHER_MAPBOX_TOKEN=
# WEATHER_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
